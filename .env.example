# Spotify integration (see src/services/spotify.js)
# Point this at your own backend/serverless endpoint that holds the
# Spotify client secret and refresh token server-side. Never put the
# client secret in a VITE_ prefixed variable — anything with that prefix
# is bundled into the browser build and becomes public.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_API_ENDPOINT=

# WakaTime secret — set this ONLY in Vercel Environment Variables.
# Do NOT prefix it with VITE_ because the API key must stay server-side.
WAKATIME_API_KEY=
